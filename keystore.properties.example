# Copy this file to keystore.properties and fill in your own signing
# credentials to sign official release builds (keystore.properties and
# keystore/ are git-ignored and never committed).
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/metaapk-release.jks \
#       -alias metaapk -keyalg RSA -keysize 2048 -validity 10000

storeFile=keystore/metaapk-release.jks
storePassword=CHANGE_ME
keyAlias=metaapk
keyPassword=CHANGE_ME
