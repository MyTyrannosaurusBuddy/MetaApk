<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Cleartext is intentional: users point the app at self-hosted /
         internal LLM gateways over plain http (e.g. office mify). TLS is
         enforced for every public endpoint by the providers themselves;
         allowing http is a first-party configuration choice, not a default
         exposure of user data. -->
    <base-config cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
